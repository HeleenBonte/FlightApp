@model FlightApp.ViewModels.ConfirmBookingVM
@{
    ViewData["Title"] = "Confirm Booking";
}

<!-- Loading Overlay -->
<div id="loading-overlay" style="display:none; position:fixed; width:100%; height:100%; top:0; left:0; right:0; bottom:0; background-color:rgba(0,0,0,0.7); z-index:9999;">
    <div class="d-flex justify-content-center align-items-center h-100">
        <div class="text-center">
            <img src="~/images/loading.gif" alt="Loading..." style="width:150px; height:150px;" />
            <h3 class="mt-3 text-white">Processing Your Booking...</h3>
            <p class="text-white">Please wait while we confirm your payment and generate your tickets.</p>
        </div>
    </div>
</div>

<div class="container mt-5">
    <div class="card shadow mb-5">
        <div class="card-header bg-primary text-white">
            <h2>Confirm Your Booking</h2>
        </div>
        <div class="card-body">
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger">
                    @TempData["Error"]
                </div>
            }

            <div class="mb-4">
                <h3 class="mb-3">Your Booking Details</h3>

                <!-- Price Summary Card - Always visible at the top -->
                <div class="row mb-3">
                    <div class="col-md-12">
                        <div class="card">
                            <div class="card-header bg-light">
                                <h4>Price Summary</h4>
                            </div>
                            <div class="card-body">
                                <h3 class="text-primary">Total Price: @Model.TotalPrice.ToString("C")</h3>
                                <p class="small text-muted">Includes all taxes and fees for all routes and flights</p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Routes Section - Works for both single and multiple routes -->
                @if (Model.Routes.Any())
                {
                    <h4 class="mt-4 mb-3">Your @(Model.Routes.Count > 1 ? "Routes" : "Route")</h4>

                    @foreach (var route in Model.Routes)
                    {
                        <div class="card mb-3">
                            <div class="card-header bg-light">
                                <h5>Route: @route.DepartureCity to @route.ArrivalCity</h5>
                            </div>
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-md-6">
                                        <p><strong>Route ID:</strong> @route.RouteId</p>
                                        <p><strong>From:</strong> @route.DepartureCity</p>
                                        <p><strong>To:</strong> @route.ArrivalCity</p>
                                        <p><strong>Departure:</strong> @(route.DepartureTime?.ToString("dd/MM/yyyy HH:mm"))</p>
                                        <p><strong>Arrival:</strong> @(route.ArrivalTime?.ToString("dd/MM/yyyy HH:mm"))</p>
                                        @if (!string.IsNullOrEmpty(route.Layover1))
                                        {
                                            <p><strong>Connection:</strong> @route.Layover1</p>
                                        }
                                        @if (!string.IsNullOrEmpty(route.Layover2))
                                        {
                                            <p><strong>Connection 2:</strong> @route.Layover2</p>
                                        }
                                    </div>
                                    <div class="col-md-6">
                                        <p><strong>Passengers:</strong></p>
                                        <ul>
                                            @foreach (var passenger in route.Passengers)
                                            {
                                                <li>@passenger.FirstName @passenger.LastName - @passenger.BookingClassName</li>
                                            }
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }

                <!-- Direct Flights Section -->
                @if (Model.Cart.FlightItems.Any())
                {
                    <h4 class="mt-4 mb-3">Your Direct @(Model.Cart.FlightItems.Count > 1 ? "Flights" : "Flight")</h4>

                    @foreach (var flight in Model.Cart.FlightItems)
                    {
                        <div class="card mb-3">
                            <div class="card-header bg-light">
                                <h5>Flight: @flight.DepartureCity to @flight.ArrivalCity</h5>
                            </div>
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-md-6">
                                        <p><strong>Flight ID:</strong> @flight.FlightId</p>
                                        <p><strong>From:</strong> @flight.DepartureCity</p>
                                        <p><strong>To:</strong> @flight.ArrivalCity</p>
                                        <p><strong>Departure:</strong> @(flight.DepartureTime?.ToString("dd/MM/yyyy HH:mm"))</p>
                                        <p><strong>Arrival:</strong> @(flight.ArrivalTime?.ToString("dd/MM/yyyy HH:mm"))</p>
                                        <p><strong>Price per person:</strong> @flight.Price.ToString("C")</p>
                                    </div>
                                    <div class="col-md-6">
                                        <p><strong>Passengers:</strong></p>
                                        <ul>
                                            @foreach (var passenger in flight.Passengers)
                                            {
                                                <li>
                                                    @passenger.FirstName @passenger.LastName - @passenger.BookingClassName
                                                    (@(passenger.BookingClassPriceFactor.ToString("P0")) of base price)
                                                </li>
                                            }
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }

                <div class="table-responsive mt-4">
                    <h4>All Passengers Summary</h4>
                    <table class="table table-striped table-hover">
                        <thead class="table-primary">
                            <tr>
                                <th>Passenger</th>
                                <th>Itinerary Type</th>
                                <th>From</th>
                                <th>To</th>
                                <th>Departure</th>
                                <th>Booking Class</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var route in Model.Routes)
                            {
                                @foreach (var passenger in route.Passengers)
                                {
                                    <tr>
                                        <td>@passenger.FirstName @passenger.LastName</td>
                                        <td>Route #@route.RouteId</td>
                                        <td>@route.DepartureCity</td>
                                        <td>@route.ArrivalCity</td>
                                        <td>@(route.DepartureTime?.ToString("dd/MM/yyyy HH:mm"))</td>
                                        <td>@passenger.BookingClassName</td>
                                    </tr>
                                }
                            }

                            @foreach (var flight in Model.Cart.FlightItems)
                            {
                                @foreach (var passenger in flight.Passengers)
                                {
                                    <tr>
                                        <td>@passenger.FirstName @passenger.LastName</td>
                                        <td>Flight #@flight.FlightId</td>
                                        <td>@flight.DepartureCity</td>
                                        <td>@flight.ArrivalCity</td>
                                        <td>@(flight.DepartureTime?.ToString("dd/MM/yyyy HH:mm"))</td>
                                        <td>@passenger.BookingClassName</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-header bg-primary text-white">
                    <h4>Payment Information</h4>
                </div>
                <div class="card-body">
                    <form id="paymentForm" asp-action="ProcessPayment" asp-controller="Booking" method="post">
                        <!-- Hidden fields for each route -->
                        @for (int i = 0; i < Model.Routes.Count; i++)
                        {
                            <input type="hidden" name="Routes[@i].RouteId" value="@Model.Routes[i].RouteId" />
                        }

                        <!-- Hidden fields for each flight -->
                        @for (int i = 0; i < Model.Cart.FlightItems.Count; i++)
                        {
                            <input type="hidden" name="Flights[@i].FlightId" value="@Model.Cart.FlightItems[i].FlightId" />
                        }

                        <input type="hidden" name="UserId" value="@Model.UserId" />
                        <input type="hidden" name="TotalPrice" value="@Model.TotalPrice" />

                        <!-- Credit card details (for demo only) -->
                        <div class="row justify-content-center mb-3">
                            <div class="col-md-6">
                                <label class="form-label">Card Number</label>
                                <input type="text" class="form-control" placeholder="1234 5678 9012 3456" required />
                            </div>
                        </div>

                        <div class="row justify-content-center mb-3">
                            <div class="col-md-3">
                                <label class="form-label">Expiry Date</label>
                                <input type="text" class="form-control" placeholder="MM/YY" required />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">CVV</label>
                                <input type="text" class="form-control" placeholder="123" required />
                            </div>
                        </div>

                        <div class="row justify-content-center mb-3">
                            <div class="col-md-6">
                                <label class="form-label">Cardholder Name</label>
                                <input type="text" class="form-control" placeholder="John Doe" required />
                            </div>
                        </div>

                        <div class="d-flex justify-content-center mt-4">
                            <a asp-action="Index" asp-controller="ShoppingCart" class="btn btn-secondary me-3">Back to Cart</a>
                            <button type="submit" id="confirmPaymentBtn" class="btn btn-success btn-lg">Confirm Payment</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $("#paymentForm").submit(function () {
                // Show loading overlay when form is submitted
                $("#loading-overlay").fadeIn();
                $("#confirmPaymentBtn").prop("disabled", true).html('<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Processing...');
            });
        });
    </script>
}
