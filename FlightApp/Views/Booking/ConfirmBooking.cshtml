@model FlightApp.ViewModels.ConfirmBookingVM
@{
    ViewData["Title"] = "Confirm Booking";
}

<!-- Loading Overlay -->
<div id="loading-overlay" style="display:none; position:fixed; width:100%; height:100%; top:0; left:0; right:0; bottom:0; background-color:rgba(0,0,0,0.7); z-index:9999;">
    <div class="d-flex justify-content-center align-items-center h-100">
        <div class="text-center">
            <img src="~/images/loading.gif" alt="Loading..." style="width:150px; height:150px;" />
            <h3 class="mt-3 text-white">Processing Your Booking...</h3>
            <p class="text-white">Please wait while we confirm your payment and generate your tickets.</p>
        </div>
    </div>
</div>

<div class="container mt-5">
    <div class="card shadow mb-5">
        <div class="card-header bg-primary text-white">
            <h2>Confirm Your Booking</h2>
        </div>
        <div class="card-body">
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger">
                    @TempData["Error"]
                </div>
            }

            <div class="mb-4">
                <h3 class="mb-3">Your Booking Details</h3>
                <div class="row mb-3">
                    <div class="col-md-6">
                        <div class="card">
                            <div class="card-header bg-light">
                                <h4>Route Details</h4>
                            </div>
                            <div class="card-body">
                                <p><strong>Route ID:</strong> @Model.RouteId</p>
                                <p><strong>From:</strong> @Model.DepartureCity</p>
                                <p><strong>To:</strong> @Model.ArrivalCity</p>
                                <p><strong>Departure:</strong> @(Model.DepartureTime?.ToString("dd/MM/yyyy HH:mm"))</p>
                                <p><strong>Arrival:</strong> @(Model.ArrivalTime?.ToString("dd/MM/yyyy HH:mm"))</p>
                                @if (!string.IsNullOrEmpty(Model.Layover1))
                                {
                                    <p><strong>Connection:</strong> @Model.Layover1</p>
                                }
                                @if (!string.IsNullOrEmpty(Model.Layover2))
                                {
                                    <p><strong>Connection 2:</strong> @Model.Layover2</p>
                                }
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="card">
                            <div class="card-header bg-light">
                                <h4>Price Summary</h4>
                            </div>
                            <div class="card-body">
                                <h3 class="text-primary">Total Price: @Model.TotalPrice.ToString("C")</h3>
                                <p class="small text-muted">Includes all taxes and fees</p>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-primary">
                            <tr>
                                <th>Passenger</th>
                                <th>Route</th>
                                <th>From</th>
                                <th>To</th>
                                <th>Departure</th>
                                <th>Booking Class</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var passenger in Model.Passengers)
                            {
                                <tr>
                                    <td>@passenger.FirstName @passenger.LastName</td>
                                    <td>@Model.RouteId</td>
                                    <td>@Model.DepartureCity</td>
                                    <td>@Model.ArrivalCity</td>
                                    <td>@(Model.DepartureTime?.ToString("dd/MM/yyyy HH:mm"))</td>
                                    <td>@passenger.BookingClassName</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-header bg-primary text-white">
                    <h4>Payment Information</h4>
                </div>
                <div class="card-body">
                    <form id="paymentForm" asp-action="ProcessPayment" asp-controller="Booking" method="post">
                        <input type="hidden" name="BookingId" value="0" />
                        <input type="hidden" name="RouteId" value="@Model.RouteId" />
                        <input type="hidden" name="UserId" value="@Model.UserId" />

                        <!-- Credit card details (for demo only) -->
                        <div class="row mb-3">
                            <div class="col-md-8">
                                <label class="form-label">Card Number</label>
                                <input type="text" class="form-control" placeholder="1234 5678 9012 3456" required />
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-4">
                                <label class="form-label">Expiry Date</label>
                                <input type="text" class="form-control" placeholder="MM/YY" required />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">CVV</label>
                                <input type="text" class="form-control" placeholder="123" required />
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-8">
                                <label class="form-label">Cardholder Name</label>
                                <input type="text" class="form-control" placeholder="John Doe" required />
                            </div>
                        </div>

                        <div class="d-flex justify-content-between mt-4">
                            <a asp-action="Index" asp-controller="ShoppingCart" class="btn btn-secondary">Back to Cart</a>
                            <button type="submit" id="confirmPaymentBtn" class="btn btn-success btn-lg">Confirm Payment</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $("#paymentForm").submit(function () {
                // Show loading overlay when form is submitted
                $("#loading-overlay").fadeIn();
                $("#confirmPaymentBtn").prop("disabled", true).html('<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Processing...');
            });
        });
    </script>
}