@model IEnumerable<FlightApp.ViewModels.HotelVM>
@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

@if(Model.Count() != 0)
{
    @foreach(var item in Model)
    {
        var photoUrl = item.PhotoUrls.First().Replace("square60", "max300");
        if(item != null){
            <p><a href="@item.Url">@item.Hotel_name</a></p>
        <p>@item.Price</p>
            <p>@item.PriceString</p>
            <img src="@photoUrl" />
        }
        else
        {
            <p>Error: could not find Object</p>
        }

    }
}

<form asp-action="ConfirmBooking" method="post" enctype="multipart/form-data">
    <button type="submit" class="btn btn-primary">upload</button>
</form>