@model FlightApp.ViewModels.ConfirmBookingVM
@{
    ViewData["Title"] = "Booking Confirmed - Zephyrus Airlines";
    // Extract related booking IDs from URL query string
    var relatedIdsString = Context.Request.Query["relatedIds"].ToString();
    var allBookingIds = new List<int> { Model.BookingId };

    if (!string.IsNullOrEmpty(relatedIdsString))
    {
        var relatedIds = relatedIdsString.Split(',')
            .Where(s => int.TryParse(s, out _))
            .Select(int.Parse);
        allBookingIds.AddRange(relatedIds);
    }
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
<style>
    body {
        background-color: #f8f9fa;
    }

    .card {
        border-radius: 15px;
        overflow: hidden;
    }

    .card-header {
        border-bottom: none;
    }

    .card-footer {
        border-top: none;
    }

    .table th {
        background-color: #e3f2fd;
    }

    .route-card {
        border-left: 4px solid #28a745;
        margin-bottom: 20px;
    }

    .booking-id-badge {
        font-size: 0.9rem;
        padding: 0.35em 0.65em;
        margin-left: 10px;
    }
</style>

<div class="container mt-5">
    <div class="card border-success shadow-lg">
        <div class="card-header bg-success text-white p-4">
            <div class="d-flex align-items-center">
                <div class="me-3">
                    <i class="bi bi-check-circle-fill" style="font-size: 3rem;"></i>
                </div>
                <div>
                    <h1 class="display-5 mb-0">Thank You for Booking with Zephyrus Airlines!</h1>
                    <p class="lead mb-0">Your journey awaits</p>
                </div>
            </div>
        </div>
        <div class="card-body p-4">
            @if (ViewBag.ErrorMessage != null)
            {
                <div class="alert alert-danger mb-4">
                    @ViewBag.ErrorMessage
                </div>
            }
            <div class="alert alert-success mb-4">
                <div class="row">
                    @if (allBookingIds.Count > 1)
                    {
                        <div class="col-12">
                            <h4>Multiple Routes Booking Details</h4>
                            <p><strong>Booking Date:</strong> @Model.BookingTime.ToString("d MMMM yyyy, HH:mm")</p>
                            <p class="mb-2">Your booking includes @Model.Routes.Count routes with separate booking references:</p>
                            <ul class="list-unstyled">
                                @for (int i = 0; i < Math.Min(allBookingIds.Count, Model.Routes.Count); i++)
                                {
                                    var bookingId = allBookingIds[i];
                                    var route = Model.Routes[i];
                                    <li class="mb-2">
                                        <span class="badge bg-success booking-id-badge">#@bookingId</span>
                                        <span>@route.DepartureCity to @route.ArrivalCity</span>
                                    </li>
                                }
                            </ul>
                        </div>
                    }
                    else
                    {
                        <div class="col-12">
                            <h4>Booking Details</h4>
                            <p><strong>Booking Reference:</strong> #@Model.BookingId</p>
                            @if (Model.Routes != null && Model.Routes.Count > 0)
                            {
                                <p><strong>Route:</strong> @Model.Routes[0].DepartureCity to @Model.Routes[0].ArrivalCity</p>
                            }
                            <p><strong>Booking Date:</strong> @Model.BookingTime.ToString("d MMMM yyyy, HH:mm")</p>
                        </div>
                    }
                </div>
            </div>

            <h3 class="mb-3">Your Routes</h3>
            @if (Model.Routes != null && Model.Routes.Count > 0)
            {
                <div class="row">
                    @for (int i = 0; i < Math.Min(allBookingIds.Count, Model.Routes.Count); i++)
                    {
                        var bookingId = allBookingIds[i];
                        var route = Model.Routes[i];
                        <div class="col-md-12 mb-3">
                            <div class="card route-card">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <h4>Route: @route.DepartureCity to @route.ArrivalCity</h4>
                                        <span class="badge bg-success">Booking #@bookingId</span>
                                    </div>
                                    <div class="row">
                                        <div class="col-md-4">
                                            <p><strong>Route ID:</strong> @route.RouteId</p>
                                            <p><strong>From:</strong> @route.DepartureCity</p>
                                            <p><strong>To:</strong> @route.ArrivalCity</p>
                                        </div>
                                        <div class="col-md-4">
                                            <p><strong>Departure:</strong> @route.DepartureTime?.ToString("dddd, d MMMM yyyy, HH:mm")</p>
                                            <p><strong>Arrival:</strong> @route.ArrivalTime?.ToString("dddd, d MMMM yyyy, HH:mm")</p>
                                            <p><strong>Passengers:</strong> @route.Passengers.Count</p>
                                        </div>
                                        <div class="col-md-4">
                                            @if (!string.IsNullOrEmpty(route.Layover1))
                                            {
                                                <p><strong>Connection:</strong> @route.Layover1</p>
                                            }
                                            @if (!string.IsNullOrEmpty(route.Layover2))
                                            {
                                                <p><strong>Connection 2:</strong> @route.Layover2</p>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="alert alert-info">
                    <p>No route information available.</p>
                </div>
            }

            <div class="mb-4 mt-4">
                <h3 class="mb-3">Your Flight Tickets</h3>
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-primary">
                            <tr>
                                <th>Passenger</th>
                                <th>Flight</th>
                                <th>Departure City</th>
                                <th>Arrival City</th>
                                <th>Departure Time</th>
                                <th>Arrival Time</th>
                                <th>Seat</th>
                                <th>Class</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var ticket in Model.Tickets)
                            {
                                var passenger = Model.Passengers.FirstOrDefault(p => p.PassengerId == ticket.PassengerId);

                                <tr>
                                    <td>@passenger?.FirstName @passenger?.LastName</td>
                                    <td>@ticket.FlightId</td>
                                    <td>@ticket.FlightDeparture</td>
                                    <td>@ticket.FlightArrival</td>
                                    <td>@(ticket.DepartureTime?.ToString("dd/MM/yyyy HH:mm") ?? "N/A")</td>
                                    <td>@(ticket.ArrivalTime?.ToString("dd/MM/yyyy HH:mm") ?? "N/A")</td>
                                    <td>@ticket.SeatNumber</td>
                                    <td>@ticket.BookingClassName</td>
                                    <td>
                                        <a href="@Url.Action("DownloadTicket", "Booking", new { ticketId = ticket.Id })" class="btn btn-sm btn-primary" target="_blank">
                                            <i class="bi bi-download"></i> Download Ticket
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="alert alert-info">
                <div class="d-flex">
                    <div class="me-3">
                        <i class="bi bi-info-circle-fill" style="font-size: 1.5rem;"></i>
                    </div>
                    <div>
                        <h5>Important Information</h5>
                        <ul>
                            <li>Please arrive at the airport at least 2 hours before your scheduled departure.</li>
                            <li>Don't forget to bring your passport or valid ID.</li>
                            <li>Keep your booking reference number handy for check-in.</li>
                            <li>A copy of your tickets has been sent to your email address.</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
        <div class="card-footer bg-light text-center p-4">
            <h4 class="mb-4">Thank you for choosing Zephyrus Airlines for your journey!</h4>
            <p>We look forward to providing you with an exceptional flying experience.</p>

            <div class="mt-4">
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary btn-lg">
                    <i class="bi bi-house-door-fill me-2"></i>Return to Home Page
                </a>
            </div>
        </div>
    </div>
</div>