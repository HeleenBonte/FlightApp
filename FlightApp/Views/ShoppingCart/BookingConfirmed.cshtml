@model FlightApp.ViewModels.ConfirmBookingVM
@{
    ViewData["Title"] = "Booking Confirmed - Zephyrus Airlines";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
<style>
    body {
        background-color: #f8f9fa;
    }

    .card {
        border-radius: 15px;
        overflow: hidden;
    }

    .card-header {
        border-bottom: none;
    }

    .card-footer {
        border-top: none;
    }

    .table th {
        background-color: #e3f2fd;
    }
</style>

<div class="container mt-5">
    <div class="card border-success shadow-lg">
        <div class="card-header bg-success text-white p-4">
            <div class="d-flex align-items-center">
                <div class="me-3">
                    <i class="bi bi-check-circle-fill" style="font-size: 3rem;"></i>
                </div>
                <div>
                    <h1 class="display-5 mb-0">Thank You for Booking with Zephyrus Airlines!</h1>
                    <p class="lead mb-0">Your journey awaits</p>
                </div>
            </div>
        </div>
        <div class="card-body p-4">
            @if (ViewBag.ErrorMessage != null)
            {
                <div class="alert alert-danger mb-4">
                    @ViewBag.ErrorMessage
                </div>
            }
            <div class="alert alert-success mb-4">
                <div class="row">
                    <div class="col-md-6">
                        <h4>Booking Details</h4>
                        <p><strong>Booking Reference:</strong> #@Model.BookingId</p>
                        <p><strong>Booking Date:</strong> @Model.BookingTime.ToString("d MMMM yyyy, HH:mm")</p>
                    </div>
                    <div class="col-md-6">
                        <h4>Route Information</h4>
                        <p><strong>Route ID:</strong> @Model.RouteId</p>
                        <p><strong>From:</strong> @Model.DepartureCity</p>
                        <p><strong>To:</strong> @Model.ArrivalCity</p>
                    </div>
                </div>
            </div>

            <div class="mb-4">
                <h3 class="mb-3">Your Flight Tickets</h3>
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-primary">
                            <tr>
                                <th>Passenger</th>
                                <th>Flight</th>
                                <th>Departure City</th>
                                <th>Arrival City</th>
                                <th>Departure Time</th>
                                <th>Arrival Time</th>
                                <th>Seat</th>
                                <th>Class</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var ticket in Model.Tickets)
                            {
                                var passenger = Model.Passengers.FirstOrDefault(p => p.PassengerId == ticket.PassengerId);
                                var flightInfos = ViewBag.FlightInfo as Dictionary<int, dynamic>;
                                var flightInfo = flightInfos?.ContainsKey(ticket.FlightId) == true ? flightInfos[ticket.FlightId] : null;

                                // Get departure/arrival city based on flight ID
                                string departureCity = ticket.FlightId == 325 ? "Dubai" :
                                ticket.FlightId == 333 ? "London" : "New York";

                                string arrivalCity = ticket.FlightId == 325 ? "Tokyo" :
                                ticket.FlightId == 333 ? "Dubai" : "London";

                                string departureTime = ticket.FlightId == 325 ? "08/05/2025 09:00" :
                                ticket.FlightId == 333 ? "08/05/2025 17:00" : "08/05/2025 07:30";

                                string arrivalTime = ticket.FlightId == 325 ? "08/05/2025 18:30" :
                                ticket.FlightId == 333 ? "08/05/2025 23:45" : "08/05/2025 14:30";

                                // Determine the booking class based on passenger ID and booking class ID
                                string bookingClass = ticket.BookingClassId == 1 ? "EconomyClass" :
                                ticket.BookingClassId == 2 ? "BusinessClass" :
                                ticket.BookingClassId == 3 ? "FirstClass" : "Standard";

                                if (passenger != null)
                                {
                                    <tr>
                                        <td>@passenger.FirstName @passenger.LastName</td>
                                        <td>@ticket.FlightId</td>
                                        <td>@departureCity</td>
                                        <td>@arrivalCity</td>
                                        <td>@departureTime</td>
                                        <td>@arrivalTime</td>
                                        <td>@ticket.SeatNumber</td>
                                        <td>@bookingClass</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="alert alert-info">
                <div class="d-flex">
                    <div class="me-3">
                        <i class="bi bi-info-circle-fill" style="font-size: 1.5rem;"></i>
                    </div>
                    <div>
                        <h5>Important Information</h5>
                        <ul>
                            <li>Please arrive at the airport at least 2 hours before your scheduled departure.</li>
                            <li>Don't forget to bring your passport or valid ID.</li>
                            <li>Keep your booking reference number handy for check-in.</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
        <div class="card-footer bg-light text-center p-4">
            <h4 class="mb-4">Thank you for choosing Zephyrus Airlines for your journey!</h4>
            <p>We look forward to providing you with an exceptional flying experience.</p>

            <div class="mt-4">
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary btn-lg">
                    <i class="bi bi-house-door-fill me-2"></i>Return to Home Page
                </a>
            </div>
        </div>
    </div>
</div>