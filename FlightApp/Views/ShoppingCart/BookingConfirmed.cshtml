@model FlightApp.ViewModels.ConfirmBookingVM
@{
    ViewData["Title"] = "Booking Confirmed";
}

<div class="container">
    <div class="jumbotron bg-success text-white p-4 mb-4">
        <h1 class="display-4">Booking Confirmed!</h1>
        <p class="lead">Your booking has been successfully processed and confirmed.</p>
        <hr class="my-4 bg-white">
        <p>Booking Reference: <strong>@Model.BookingId</strong></p>
        <p>Booking Date: <strong>@Model.BookingTime.ToString("d MMMM yyyy HH:mm")</strong></p>
    </div>

    <div class="card mb-4">
        <div class="card-header bg-primary text-white">
            <h2>Booking Details</h2>
        </div>
        <div class="card-body">
            <h3>Route: @Model.DepartureCity to @Model.ArrivalCity</h3>

            <div class="table-responsive">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Passenger Name</th>
                            <th>RouteId</th>
                            <th>DepartureTime</th>
                            <th>Departure City</th>
                            <th>Arrival City</th>
                            <th>Arrival Time</th>
                            <th>Layover1</th>
                            <th>Layover2</th>
                            <th>BookingClass</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var passenger in Model.Passengers)
                        {
                            <tr>
                                <td>@passenger.FirstName @passenger.LastName</td>
                                <td>@Model.RouteId</td>
                                <td>@(Model.DepartureTime.HasValue ? Model.DepartureTime.Value.ToString("d/MM/yyyy H:mm:ss") : "N/A")</td>
                                <td>@Model.DepartureCity</td>
                                <td>@Model.ArrivalCity</td>
                                <td>@(Model.ArrivalTime.HasValue ? Model.ArrivalTime.Value.ToString("d/MM/yyyy H:mm:ss") : "N/A")</td>
                                <td>@(string.IsNullOrEmpty(Model.Layover1) ? "-" : Model.Layover1)</td>
                                <td>@(string.IsNullOrEmpty(Model.Layover2) ? "-" : Model.Layover2)</td>
                                <td>@passenger.BookingClassName</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="alert alert-info mt-3">
                <h4>Total Paid: @Model.TotalPrice.ToString("C")</h4>
            </div>

            <h3 class="mt-4">Ticket Details</h3>
            <div class="table-responsive">
                <table class="table table-bordered">
                    <thead>
                        <tr class="table-primary">
                            <th>Flight</th>
                            <th>Passenger</th>
                            <th>Seat Number</th>
                            <th>Booking Class</th>
                            <th>Meal Choice</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ticket in Model.Tickets)
                        {
                            var passenger = Model.Passengers.FirstOrDefault(p => p.PassengerId == ticket.PassengerId);
                            <tr>
                                <td>@ticket.FlightId</td>
                                <td>@(passenger?.FirstName ?? "") @(passenger?.LastName ?? "")</td>
                                <td>@ticket.SeatNumber</td>
                                <td>@(passenger?.BookingClassName ?? "")</td>
                                <td>@ticket.MealChoiceId</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="text-center mb-5">
        <h4>Thank you for flying with us!</h4>
        <p>You will receive a confirmation email shortly at the email addresses provided.</p>
        <div class="mt-4">
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Return to Home</a>
            <a asp-controller="Flights" asp-action="GetRoutes" class="btn btn-outline-primary ml-2">Book Another Flight</a>
        </div>
    </div>
</div>