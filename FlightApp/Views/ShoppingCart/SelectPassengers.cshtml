@model FlightApp.ViewModels.RouteCartItemVM
@using FlightApp.ViewModels
@{
    ViewData["Title"] = "Select Passengers";
    var mealChoices = ViewBag.MealChoices as List<MealChoiceVM> ?? new List<MealChoiceVM>();
    var departureCityId = ViewBag.DepartureCityId;
    var arrivalCityId = ViewBag.ArrivalCityId;
}

<div class="container mt-4">
    <h2>Passenger Selection</h2>

    <div class="card mb-4">
        <div class="card-header">
            <h4>Flight Details</h4>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <p><strong>From:</strong> @Model.DepartureCity</p>
                    <p><strong>To:</strong> @Model.ArrivalCity</p>
                </div>
                <div class="col-md-6">
                    <p><strong>Departure:</strong> @Model.DepartureTime.ToString("dd MMM yyyy HH:mm")</p>
                    @if (Model.ArrivalTime.HasValue)
                    {
                        <p><strong>Arrival:</strong> @Model.ArrivalTime.Value.ToString("dd MMM yyyy HH:mm")</p>
                    }
                </div>
            </div>

            @if (!string.IsNullOrEmpty(Model.Layover1))
            {
                <div class="alert alert-info">
                    <p><strong>Connection via:</strong> @Model.Layover1</p>
                </div>
            }

            @if (!string.IsNullOrEmpty(Model.Layover2))
            {
                <div class="alert alert-info">
                    <p><strong>Connection via:</strong> @Model.Layover2</p>
                </div>
            }
        </div>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <div class="alert alert-warning" id="duplicateNamesWarning" style="display: none;">
        <strong>Note:</strong> All passenger names must be unique. Two passengers cannot have the same first and last name.
    </div>

    <form asp-action="SavePassengers" asp-controller="ShoppingCart" method="post" id="passengerForm" class="needs-validation">
        <input type="hidden" name="routeId" value="@Model.RouteId" />

        <div class="card mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h4>Select Number of Passengers</h4>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <label for="passengerCount" class="form-label">Number of Passengers:</label>
                        <select id="passengerCount" name="passengerCount" class="form-select">
                            @for (int i = 1; i <= 10; i++)
                            {
                                <option value="@i" selected="@(i == Model.PassengerCount)">@i</option>
                            }
                        </select>
                    </div>
                </div>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h4>Enter Passenger Details</h4>
                <span class="text-muted" id="passengerCountDisplay">Total passengers: @Model.PassengerCount</span>
            </div>
            <div class="card-body">
                <div id="passengersContainer">
                    <!-- Passenger forms will be generated here by JavaScript -->
                </div>
            </div>
        </div>

        <div class="d-grid gap-2 d-md-flex justify-content-md-end mb-4">
            <button type="submit" class="btn btn-primary">Add to Cart</button>
        </div>
    </form>
</div>

@section Scripts {
    <script src="~/js/passengerForms.js"></script>
    <script>
        // Define meal choices directly as a JavaScript object - using proper serialization
        var mealChoices = @Json.Serialize(mealChoices);
        var departureCityId = @Json.Serialize(departureCityId);
        var arrivalCityId = @Json.Serialize(arrivalCityId);

        document.addEventListener('DOMContentLoaded', function() {
            // Pass the meal choices directly to the generate function
            generatePassengerForms(@Model.PassengerCount, mealChoices, departureCityId, arrivalCityId);

            // Update the passenger count dropdown handler
            const passengerCountDropdown = document.getElementById('passengerCount');
            passengerCountDropdown.addEventListener('change', function () {
                const selectedCount = parseInt(this.value, 10);
                generatePassengerForms(selectedCount, mealChoices);
            });
            
            // Form validation
            const form = document.getElementById('passengerForm');
            
            form.addEventListener('submit', function(event) {
                // Prevent form submission
                event.preventDefault();
                
                // Check for duplicate names
                if (checkDuplicateNames()) {
                    alert('Please ensure all passenger names are unique.');
                    return false;
                }
                
                // Check all required fields
                const allInputs = form.querySelectorAll('input[required], select[required]');
                let isValid = true;
                
                allInputs.forEach(input => {
                    if (!input.value.trim()) {
                        input.classList.add('is-invalid');
                        isValid = false;
                    } else {
                        input.classList.remove('is-invalid');
                    }
                });
                
                // Check meal preferences specifically
                const mealSelects = form.querySelectorAll('select[name$=".MealChoiceId"]');
                mealSelects.forEach(select => {
                    if (!select.value || select.value === '') {
                        select.classList.add('is-invalid');
                        isValid = false;
                    } else {
                        select.classList.remove('is-invalid');
                    }
                });
                
                if (!isValid) {
                    alert('Please fill in all required fields for all passengers.');
                    return false;
                }
                
                // If everything is valid, submit the form
                form.submit();
            });
        });
    </script>
}