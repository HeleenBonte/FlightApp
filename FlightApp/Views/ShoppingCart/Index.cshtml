@model FlightApp.ViewModels.ShoppingCartVM

@{
    ViewData["Title"] = "Your Basket";
}

<h1>Your Basket</h1>

@if (TempData["Message"] != null)
{
    <div class="alert alert-info">@TempData["Message"]</div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@if (!Model.RouteItems.Any() && !Model.FlightItems.Any())
{
    <div class="alert alert-warning">Your basket is empty.</div>
    <p>
        <a asp-controller="Flights" asp-action="GetRoutes" class="btn btn-primary">Search for Routes</a>
        <a asp-controller="Flights" asp-action="Index" class="btn btn-primary">Search for Flights</a>
    </p>
}
else
{
    <div class="container mt-4 mb-5">
        <!-- ITINERARIES SECTION -->
        <div class="card mb-4">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0">Your Itineraries</h4>
            </div>
            <div class="card-body">
                <div class="row">
                    <!-- Routes -->
                    @if (Model.RouteItems.Any())
                    {
                        <div class="col-md-12 mb-4">
                            <h5>Routes</h5>
                            <div class="table-responsive">
                                <table class="table table-striped">
                                    <thead>
                                        <tr>
                                            <th>Amount</th>
                                            <th>Departure</th>
                                            <th>From</th>
                                            <th>To</th>
                                            <th>Arrival</th>
                                            <th>Price</th>
                                            <th>Booking Class</th>
                                            <th>Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in Model.RouteItems)
                                        {
                                            // Group passengers by booking class
                                            var passengersByClass = item.Passengers?
                                            .GroupBy(p => p.BookingClassId)
                                            .ToDictionary(g => g.Key, g => g.ToList());

                                            if (passengersByClass != null && passengersByClass.Any())
                                            {
                                                // Display one row for each booking class
                                                foreach (var classGroup in passengersByClass)
                                                {
                                                    var passengers = classGroup.Value;
                                                    var bookingClass = passengers.FirstOrDefault();
                                                    var count = passengers.Count;

                                                    <tr>
                                                        <td>@count</td>
                                                        <td>@item.DepartureTime.ToString("dd/MM/yyyy HH:mm")</td>
                                                        <td>@item.DepartureCity</td>
                                                        <td>@item.ArrivalCity</td>
                                                        <td>@(item.ArrivalTime?.ToString("dd/MM/yyyy HH:mm") ?? "N/A")</td>
                                                        <td>
                                                            @{
                                                                // Calculate price for this booking class
                                                                double adjustedPrice = item.Flights.Sum(f => f.Price ?? 0) * bookingClass.BookingClassPriceFactor * count;
                                                            }
                                                            @adjustedPrice.ToString("C")
                                                        </td>
                                                        <td>@bookingClass.BookingClassName</td>
                                                        <td>
                                                            <form asp-action="RemoveRouteFromCart" asp-controller="ShoppingCart" method="post">
                                                                <input type="hidden" name="routeId" value="@item.RouteId" />
                                                                <button type="submit" class="btn btn-sm btn-danger">Remove</button>
                                                            </form>
                                                        </td>
                                                    </tr>
                                                }

                                                <!-- Show holiday price notes if any flight has them -->
                                                var flightsWithNotes = item.Flights.Where(f => !string.IsNullOrEmpty(f.Notes)).ToList();

                                                @if (flightsWithNotes.Any())
                                                {
                                                    <tr class="table-info">
                                                        <td colspan="8">
                                                            <div class="small">
                                                                <i class="bi bi-info-circle me-1"></i>
                                                                <strong>Holiday pricing applied:</strong>
                                                                @foreach (var flight in flightsWithNotes)
                                                                {
                                                                    <span class="ms-2 badge bg-info text-dark">
                                                                        @flight.DepartureCity to @flight.ArrivalCity: @flight.Notes
                                                                    </span>
                                                                }
                                                            </div>
                                                        </td>
                                                    </tr>
                                                }
                                            }
                                            else
                                            {
                                                <!-- No passengers assigned yet, show default row -->
                                                <tr>
                                                    <td>@item.PassengerCount</td>
                                                    <td>@item.DepartureTime.ToString("dd/MM/yyyy HH:mm")</td>
                                                    <td>@item.DepartureCity</td>
                                                    <td>@item.ArrivalCity</td>
                                                    <td>@(item.ArrivalTime?.ToString("dd/MM/yyyy HH:mm") ?? "N/A")</td>
                                                    <td>@(item.GetTotalPrice().ToString("C"))</td>
                                                    <td>Not specified</td>
                                                    <td>
                                                        <form asp-action="RemoveRouteFromCart" asp-controller="ShoppingCart" method="post">
                                                            <input type="hidden" name="routeId" value="@item.RouteId" />
                                                            <button type="submit" class="btn btn-sm btn-danger">Remove</button>
                                                        </form>
                                                    </td>
                                                </tr>

                                                <!-- Show holiday price notes if any flight has them -->
                                                var flightsWithNotes = item.Flights.Where(f => !string.IsNullOrEmpty(f.Notes)).ToList();
                                                @if (flightsWithNotes.Any())
                                                {
                                                    <tr class="table-info">
                                                        <td colspan="8">
                                                            <div class="small">
                                                                <i class="bi bi-info-circle me-1"></i>
                                                                <strong>Holiday pricing applied:</strong>
                                                                @foreach (var flight in flightsWithNotes)
                                                                {
                                                                    <span class="ms-2 badge bg-info text-dark">
                                                                        @flight.DepartureCity to @flight.ArrivalCity: @flight.Notes
                                                                    </span>
                                                                }
                                                            </div>
                                                        </td>
                                                    </tr>
                                                }
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    }

                    <!-- Flights -->
                    @if (Model.FlightItems.Any())
                    {
                        <div class="col-md-12 mb-4">
                            <h5>Direct Flights</h5>
                            <div class="table-responsive">
                                <table class="table table-striped">
                                    <thead>
                                        <tr>
                                            <th>Amount</th>
                                            <th>Departure</th>
                                            <th>From</th>
                                            <th>To</th>
                                            <th>Arrival</th>
                                            <th>Price</th>
                                            <th>Booking Class</th>
                                            <th>Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in Model.FlightItems)
                                        {
                                            // Group passengers by booking class
                                            var passengersByClass = item.Passengers?
                                            .GroupBy(p => p.BookingClassId)
                                            .ToDictionary(g => g.Key, g => g.ToList());

                                            if (passengersByClass != null && passengersByClass.Any())
                                            {
                                                // Display one row for each booking class
                                                foreach (var classGroup in passengersByClass)
                                                {
                                                    var passengers = classGroup.Value;
                                                    var bookingClass = passengers.FirstOrDefault();
                                                    var count = passengers.Count;

                                                    <tr>
                                                        <td>@count</td>
                                                        <td>@(item.DepartureTime?.ToString("dd/MM/yyyy HH:mm") ?? "N/A")</td>
                                                        <td>@item.DepartureCity</td>
                                                        <td>@item.ArrivalCity</td>
                                                        <td>@(item.ArrivalTime?.ToString("dd/MM/yyyy HH:mm") ?? "N/A")</td>
                                                        <td>
                                                            @{
                                                                // Calculate price for this booking class
                                                                double adjustedPrice = item.Price * bookingClass.BookingClassPriceFactor * count;
                                                            }
                                                            @adjustedPrice.ToString("C")
                                                        </td>
                                                        <td>@bookingClass.BookingClassName</td>
                                                        <td>
                                                            <form asp-action="RemoveFlightFromCart" asp-controller="ShoppingCart" method="post">
                                                                <input type="hidden" name="flightId" value="@item.FlightId" />
                                                                <button type="submit" class="btn btn-sm btn-danger">Remove</button>
                                                            </form>
                                                        </td>
                                                    </tr>
                                                }

                                                <!-- Show holiday price notes if any -->
                                                @if (!string.IsNullOrEmpty(item.Notes))
                                                {
                                                    <tr class="table-info">
                                                        <td colspan="8">
                                                            <div class="small">
                                                                <i class="bi bi-info-circle me-1"></i>
                                                                <strong>Holiday pricing applied:</strong>
                                                                <span class="ms-2 badge bg-info text-dark">
                                                                    @item.DepartureCity to @item.ArrivalCity: @item.Notes
                                                                </span>
                                                            </div>
                                                        </td>
                                                    </tr>
                                                }
                                            }
                                            else
                                            {
                                                <!-- No passengers assigned yet, show default row -->
                                                <tr>
                                                    <td>@item.PassengerCount</td>
                                                    <td>@(item.DepartureTime?.ToString("dd/MM/yyyy HH:mm") ?? "N/A")</td>
                                                    <td>@item.DepartureCity</td>
                                                    <td>@item.ArrivalCity</td>
                                                    <td>@(item.ArrivalTime?.ToString("dd/MM/yyyy HH:mm") ?? "N/A")</td>
                                                    <td>@(item.GetTotalPrice().ToString("C"))</td>
                                                    <td>
                                                        @if (item.Passengers != null && item.Passengers.Any())
                                                        {
                                                            <span class="badge bg-success">Selected</span>
                                                        }
                                                        else
                                                        {
                                                            <a class="btn btn-sm btn-primary" asp-action="SelectFlightPassengers" asp-route-flightId="@item.FlightId">
                                                                Select Passengers
                                                            </a>
                                                        }
                                                    </td>
                                                    <td>
                                                        <form asp-action="RemoveFlightFromCart" asp-controller="ShoppingCart" method="post">
                                                            <input type="hidden" name="flightId" value="@item.FlightId" />
                                                            <button type="submit" class="btn btn-sm btn-danger">Remove</button>
                                                        </form>
                                                    </td>
                                                </tr>

                                                <!-- Show holiday price notes if any -->
                                                @if (!string.IsNullOrEmpty(item.Notes))
                                                {
                                                    <tr class="table-info">
                                                        <td colspan="8">
                                                            <div class="small">
                                                                <i class="bi bi-info-circle me-1"></i>
                                                                <strong>Holiday pricing applied:</strong>
                                                                <span class="ms-2 badge bg-info text-dark">
                                                                    @item.DepartureCity to @item.ArrivalCity: @item.Notes
                                                                </span>
                                                            </div>
                                                        </td>
                                                    </tr>
                                                }
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    }
                </div>

                <div class="mt-4 pt-2 border-top">
                    <div class="row">
                        <div class="col-md-6">
                            <h4>Total: @Model.ComputeTotalValue().ToString("C")</h4>
                        </div>
                        <div class="col-md-6 text-end">
                            <div class="d-flex justify-content-end">
                                <a asp-controller="Flights" asp-action="GetRoutes" class="btn btn-secondary me-2">Continue Shopping</a>
                                <form asp-action="ClearCart" asp-controller="ShoppingCart" method="post" class="me-2">
                                    <button type="submit" class="btn btn-danger">Clear Cart</button>
                                </form>
                                <a asp-action="ConfirmBooking" asp-controller="Booking" class="btn btn-success">Proceed to Checkout</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
