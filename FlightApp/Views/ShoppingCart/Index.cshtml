@model FlightApp.ViewModels.ShoppingCartVM

@{
    ViewData["Title"] = "Your Basket";
}

<h1>Your Basket</h1>

@if (TempData["Message"] != null)
{
    <div class="alert alert-info">@TempData["Message"]</div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@if (!Model.RouteItems.Any())
{
    <div class="alert alert-warning">Your basket is empty.</div>
    <p>
        <a asp-controller="Flights" asp-action="GetRoutes" class="btn btn-primary">Search for Routes</a>
    </p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Amount</th>
                <th>RouteId</th>
                <th>Departure Time</th>
                <th>Departure City</th>
                <th>Arrival City</th>
                <th>Arrival Time</th>
                <th>Price</th>
                <th>Booking Class</th>
                <th>Remove from cart</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.RouteItems)
            {
                // Group passengers by booking class
                var passengersByClass = item.Passengers?
                .GroupBy(p => p.BookingClassId)
                .ToDictionary(g => g.Key, g => g.ToList());

                if (passengersByClass != null && passengersByClass.Any())
                {
                    // Display one row for each booking class
                    foreach (var classGroup in passengersByClass)
                    {
                        var passengers = classGroup.Value;
                        var bookingClass = passengers.FirstOrDefault();
                        var count = passengers.Count;

                        <tr>
                            <td>@count</td>
                            <td>@item.RouteId</td>
                            <td>@item.DepartureTime.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@item.DepartureCity</td>
                            <td>@item.ArrivalCity</td>
                            <td>@(item.ArrivalTime?.ToString("dd/MM/yyyy HH:mm") ?? "N/A")</td>
                            <td>
                                @{
                                    // Calculate price for this booking class
                                    double adjustedPrice = item.Flights.Sum(f => f.Price ?? 0) * bookingClass.BookingClassPriceFactor * count;
                                }
                                @adjustedPrice.ToString("C")
                            </td>
                            <td>@bookingClass.BookingClassName</td>
                            <td>
                                <form asp-action="RemoveRouteFromCart" asp-controller="ShoppingCart" method="post">
                                    <input type="hidden" name="routeId" value="@item.RouteId" />
                                    <button type="submit" class="btn btn-sm btn-danger">Remove</button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    // No passengers assigned yet, show default row
                    <tr>
                        <td>@item.PassengerCount</td>
                        <td>@item.RouteId</td>
                        <td>@item.DepartureTime.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@item.DepartureCity</td>
                        <td>@item.ArrivalCity</td>
                        <td>@(item.ArrivalTime?.ToString("dd/MM/yyyy HH:mm") ?? "N/A")</td>
                        <td>@(item.GetTotalPrice().ToString("C"))</td>
                        <td>Not specified</td>
                        <td>
                            <form asp-action="RemoveRouteFromCart" asp-controller="ShoppingCart" method="post">
                                <input type="hidden" name="routeId" value="@item.RouteId" />
                                <button type="submit" class="btn btn-sm btn-danger">Remove</button>
                            </form>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>

    <div class="text-right">
        <h4>Total: @Model.ComputeTotalValue().ToString("C")</h4>
    </div>

    <div class="mt-3 d-flex justify-content-between">
        <a asp-controller="Flights" asp-action="GetRoutes" class="btn btn-secondary">Continue Shopping</a>
        <form asp-action="ClearCart" asp-controller="ShoppingCart" method="post" class="mx-2">
            <button type="submit" class="btn btn-danger">Remove All from Cart</button>
        </form>
        <a asp-action="ConfirmBooking" asp-controller="Booking" class="btn btn-success">Proceed to Checkout</a>
    </div>
}