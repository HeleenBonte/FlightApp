@model FlightApp.ViewModels.ShoppingCartVM

@{
    ViewData["Title"] = "Your Basket";
}

<h1>Your Basket</h1>

@if (TempData["Message"] != null)
{
    <div class="alert alert-info">@TempData["Message"]</div>
}

@if (Model.RouteItems.Count == 0)
{
    <div class="alert alert-warning">Your basket is empty.</div>
    <p>
        <a asp-controller="Flights" asp-action="GetRoutes" class="btn btn-primary">Search for Routes</a>
    </p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Route</th>
                <th>Departure</th>
                <th>Arrival</th>
                <th>Layovers</th>
                <th>Passengers</th>
                <th>Price</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.RouteItems)
            {
                <tr>
                    <td>@item.RouteId</td>
                    <td>@item.DepartureCity<br />@item.DepartureTime.ToString("g")</td>
                    <td>@item.ArrivalCity</td>
                    <td>
                        @if (!string.IsNullOrEmpty(item.Layover1))
                        {
                            @item.Layover1
                            @if (!string.IsNullOrEmpty(item.Layover2))
                            {
                                <span>, @item.Layover2</span>
                            }
                        }
                        else
                        {
                            <span>Direct</span>
                        }
                    </td>
                    <td>
                        @foreach (var passenger in item.Passengers)
                        {
                            <div>@passenger.FirstName @passenger.LastName</div>
                        }
                        <a asp-controller="ShoppingCart" asp-action="AddPassengerToRoute" asp-route-routeId="@item.RouteId" 
                           class="btn btn-sm btn-secondary">+</a>
                    </td>
                    <td>€@(item.Passengers.Count * item.TotalPrice)</td>
                    <td>
                        <a asp-controller="ShoppingCart" asp-action="RemoveRouteFromCart" asp-route-id="@item.RouteId" 
                           class="btn btn-danger">Remove</a>
                    </td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <td colspan="5" class="text-right"><strong>Total:</strong></td>
                <td>€@Model.ComputeTotalValue()</td>
                <td></td>
            </tr>
        </tfoot>
    </table>

    <div class="row mt-3">
        <div class="col-md-6">
            <a asp-controller="Flights" asp-action="GetRoutes" class="btn btn-secondary">Continue Shopping</a>
        </div>
        <div class="col-md-6 text-right">
            <a href="#" class="btn btn-primary">Proceed to Checkout</a>
        </div>
    </div>
}
