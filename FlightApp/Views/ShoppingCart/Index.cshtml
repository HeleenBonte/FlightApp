@model FlightApp.ViewModels.ShoppingCartVM

@{
    ViewData["Title"] = "Your Basket";
}

<h1>Your Basket</h1>

@if (TempData["Message"] != null)
{
    <div class="alert alert-info">@TempData["Message"]</div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@if (Model.RouteItems.Count == 0)
{
    <div class="alert alert-warning">Your basket is empty.</div>
    <p>
        <a asp-controller="Flights" asp-action="GetRoutes" class="btn btn-primary">Search for Routes</a>
    </p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Route</th>
                <th>Departure</th>
                <th>Arrival</th>
                <th>Arrival Time</th> <!-- Added ArrivalTime column -->
                <th>Passengers</th>
                <th>Price</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.RouteItems)
            {
                <tr>
                    <td>@item.RouteId</td>
                    <td>@item.DepartureCity<br />@item.DepartureTime.ToString("g")</td>
                    <td>@item.ArrivalCity</td>
                    <td>@item.ArrivalTime?.ToString("g")</td> <!-- Display ArrivalTime -->
                    <td>
                        <form asp-action="DecreasePassengerCount" method="post" style="display:inline;">
                            <input type="hidden" name="routeId" value="@item.RouteId" />
                            <button class="btn btn-sm btn-secondary" @(item.PassengerCount <= 1 ? "disabled" : "")> - </button>
                        </form>
                        @item.PassengerCount
                        <form asp-action="IncreasePassengerCount" method="post" style="display:inline;">
                            <input type="hidden" name="routeId" value="@item.RouteId" />
                            <button class="btn btn-sm btn-secondary"> + </button>
                        </form>
                    </td>
                    <td>€@item.TotalPrice</td>
                    <td>
                        <form asp-action="RemoveRouteFromCart" method="post">
                            <input type="hidden" name="id" value="@item.RouteId" />
                            <button type="submit" class="btn btn-danger">Remove</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <td colspan="5" class="text-right"><strong>Total:</strong></td>
                <td>€@Model.ComputeTotalValue()</td>
                <td></td>
            </tr>
        </tfoot>
    </table>

    <div class="row mt-3">
        <div class="col-md-6">
            <a asp-controller="Flights" asp-action="GetRoutes" class="btn btn-secondary">Continue Shopping</a>
        </div>
        <div class="col-md-6 text-right">
            <a href="#" class="btn btn-primary">Proceed to Checkout</a>
        </div>
    </div>
}
