@model FlightApp.ViewModels.FlightListHotelListVM

<div class="results-container mt-3">
    @if (Model.flights != null && Model.flights.Any())
    {
        <div class="search-results">
            @foreach (var flight in Model.flights)
            {
                <div class="card mb-3">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">Flight #@flight.FlightId</h5>
                        <span class="badge bg-primary">€@flight.Price</span>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-9">
                                <div class="d-flex justify-content-between">
                                    <div>
                                        <p class="mb-0"><strong>@flight.DepartureCity</strong></p>
                                        <p class="text-muted">@flight.DepartureTime?.ToString("HH:mm")</p>
                                    </div>
                                    <div class="flex-grow-1 text-center">
                                        <i class="bi bi-arrow-right"></i>
                                    </div>
                                    <div>
                                        <p class="mb-0"><strong>@flight.ArrivalCity</strong></p>
                                        <p class="text-muted">@flight.ArrivalTime?.ToString("HH:mm")</p>
                                    </div>
                                </div>
                                <div class="mt-2">
                                    <p class="mb-0">
                                        <strong>Date:</strong>
                                        @flight.DepartureTime?.ToString("dd MMM yyyy")
                                    </p>
                                </div>
                            </div>
                            <div class="col-md-3 d-flex align-items-center justify-content-end">
                                <a asp-controller="Flights" asp-action="AddToCart" asp-route-id="@flight.FlightId"
                                   class="btn btn-success">
                                    <i class="bi bi-cart-plus"></i> Add to Cart
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-warning">
            No flights found matching your criteria.
        </div>
    }
    @if (Model.hotels.Count() != 0 && Model.hotels.Any())
    {
        <div>
            @foreach (var item in Model.hotels)
            {
                <div class="hotel-tile">
                    @await Html.PartialAsync("DisplayTemplates/_HotelTile", item)
                </div>
            }
        </div>
    }


</div>