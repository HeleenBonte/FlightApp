@model FlightApp.ViewModels.FlightListHotelListVM

<div class="results-container mt-3">
    @if (Model != null && Model.flights != null && Model.flights.Any())
    {
        <div class="search-results">
            @foreach (var flight in Model.flights)
            {
                <div class="card mb-3">
                    <div class="card-header d-flex justify-content-between align-items-center bg-primary text-white">
                        <h5 class="mb-0">Flight #@flight.FlightId</h5>
                        <span class="badge bg-light text-primary">€@flight.Price?.ToString("N2")</span>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <!-- Main flight -->
                            <div class="col-12 mb-3">
                                <div class="d-flex align-items-center">
                                    <div class="text-center me-2">
                                        <p class="mb-0"><strong>@flight.DepartureCity</strong></p>
                                        <p class="text-muted">@flight.DepartureTime?.ToString("HH:mm")</p>
                                    </div>
                                    <div class="flex-grow-1 d-flex justify-content-center align-items-center">
                                        <hr class="flex-grow-1 border-2 border-primary" />
                                        <i class="bi bi-airplane mx-2 fs-4 text-primary"></i>
                                        <hr class="flex-grow-1 border-2 border-primary" />
                                    </div>
                                    <div class="text-center ms-2">
                                        <p class="mb-0"><strong>@flight.ArrivalCity</strong></p>
                                        <p class="text-muted">@flight.ArrivalTime?.ToString("HH:mm")</p>
                                    </div>
                                </div>
                            </div>

                            <!-- Holiday price factor indicator -->
                            @if (!string.IsNullOrEmpty(flight.Notes))
                            {
                                <div class="col-12 mb-2">
                                    <div class="alert alert-info mb-0">
                                        <i class="bi bi-info-circle me-2"></i>@flight.Notes
                                    </div>
                                </div>
                            }

                            <!-- Date and action button -->
                            <div class="col-8">
                                <p class="mb-0">
                                    <strong>Date:</strong> @flight.DepartureTime?.ToString("dd MMM yyyy")
                                </p>
                            </div>
                            <div class="col-4 text-end">
                                <a href="@Url.Action("AddToCart", "Flights", new { id = flight.FlightId })"
                                   class="btn btn-primary">
                                    <i class="bi bi-cart-plus"></i> Add to Cart
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-warning">
            <div class="d-flex align-items-center">
                <i class="bi bi-exclamation-triangle-fill fs-3 me-3"></i>
                <div>
                    <p class="mb-0">No flights found matching your criteria. Please try different search parameters.</p>
                </div>
            </div>
        </div>
    }

    @if (Model?.hotels != null && Model.hotels.Any())
    {
        <div class="card shadow border-info mt-4">
            <div class="card-header bg-info text-white">
                <h3><i class="bi bi-building me-2"></i>Recommended Hotels</h3>
            </div>
            <div class="card-body">
                <div class="row">
                    @foreach (var hotel in Model.hotels)
                    {
                        <div class="col-md-4 mb-4">
                            <div class="card h-100 shadow-sm">
                                @await Html.PartialAsync("DisplayTemplates/_HotelTile", hotel)
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>