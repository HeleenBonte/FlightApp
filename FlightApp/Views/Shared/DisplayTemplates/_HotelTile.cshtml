@model FlightApp.ViewModels.HotelVM

@if(Model != null){
    var photoUrl = Model.PhotoUrls.First().Replace("square60", "max300");
    <a class="tile col-md-6" href="@Model.Url">
<div >
            @if (!Model.isApiData)
            {
                <p>Dit hotel werd niet uit de api opgehaald, dit doordat de api key niet meer geldig is (te veel calls) of door problemen op de api server</p>
            }
            <h3>@Model.Hotel_name</h3>
   <h3>@Model.ReviewScore &frasl;10</h3>
   <p>@Model.PriceString per person per night</p>
   <img src="@photoUrl" alt="Hotel Picture" />
</div>
    </a>
}
else
{
    <p>We could not retrieve hotel, please try again later</p>
}
