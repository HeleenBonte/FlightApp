@model FlightApp.ViewModels.RouteListHotelListVM

<div class="results-container mt-3">
    @if (Model.routes.Any())
    {
        <div class="search-results">
            @foreach (var route in Model.routes)
            {
                // Price is now calculated in the controller with holiday factors applied

                <div class="card mb-3">
                    <div class="card-header d-flex justify-content-between align-items-center bg-success text-white">
                        <h5 class="mb-0">Route #@route.RouteId</h5>
                        <span class="badge bg-light text-success">€@route.Price.ToString("N2")</span>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <!-- Main route -->
                            <div class="col-12 mb-3">
                                <div class="d-flex align-items-center">
                                    <div class="text-center me-2">
                                        <p class="mb-0"><strong>@route.DepartureCity</strong></p>
                                        <p class="text-muted">@route.DepartureTime?.ToString("HH:mm")</p>
                                    </div>
                                    <div class="flex-grow-1 d-flex justify-content-center align-items-center">
                                        <hr class="flex-grow-1 border-2 border-success" />
                                        <i class="bi bi-arrow-right mx-2 fs-4 text-success"></i>
                                        <hr class="flex-grow-1 border-2 border-success" />
                                    </div>
                                    <div class="text-center ms-2">
                                        <p class="mb-0"><strong>@route.ArrivalCity</strong></p>
                                        <p class="text-muted">@route.ArrivalTime?.ToString("HH:mm")</p>
                                    </div>
                                </div>
                            </div>

                            <!-- Holiday price factor indicators -->
                            @{
                                var flightsWithHolidayPricing = route.Flights.Where(f => !string.IsNullOrEmpty(f.Notes)).ToList();
                            }
                            @if (flightsWithHolidayPricing.Any())
                            {
                                <div class="col-12 mb-2">
                                    <div class="alert alert-info mb-0">
                                        <strong><i class="bi bi-info-circle me-2"></i>Holiday Pricing Applied:</strong>
                                        <ul class="mb-0 mt-1">
                                            @foreach (var flight in flightsWithHolidayPricing)
                                            {
                                                <li>@flight.DepartureCity to @flight.ArrivalCity: @flight.Notes</li>
                                            }
                                        </ul>
                                    </div>
                                </div>
                            }

                            <!-- Layover information (rest of code stays the same) -->
                            @if (!string.IsNullOrEmpty(route.Layover1) || !string.IsNullOrEmpty(route.Layover2))
                            {
                                <div class="col-12 mb-2">
                                    <div class="row">
                                        @if (!string.IsNullOrEmpty(route.Layover1))
                                        {
                                            <div class="col-md-6 mb-2">
                                                <div class="card card-body bg-light py-2">
                                                    <strong>Layover 1:</strong>
                                                    <div class="d-flex align-items-center mt-1">
                                                        <div>@route.Layover1</div>
                                                        <div class="flex-grow-1 d-flex justify-content-center">
                                                            <i class="bi bi-arrow-right text-secondary mx-2"></i>
                                                        </div>
                                                        <div>@(!string.IsNullOrEmpty(route.Layover2) ? route.Layover2 : route.ArrivalCity)</div>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                        @if (!string.IsNullOrEmpty(route.Layover2))
                                        {
                                            <div class="col-md-6 mb-2">
                                                <div class="card card-body bg-light py-2">
                                                    <strong>Layover 2:</strong>
                                                    <div class="d-flex align-items-center mt-1">
                                                        <div>@route.Layover2</div>
                                                        <div class="flex-grow-1 d-flex justify-content-center">
                                                            <i class="bi bi-arrow-right text-secondary mx-2"></i>
                                                        </div>
                                                        <div>@route.ArrivalCity</div>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }

                            <!-- Date and action button (unchanged) -->
                            <div class="col-8">
                                <p class="mb-0">
                                    <strong>Date:</strong> @route.DepartureTime?.ToString("dd MMM yyyy")
                                </p>
                            </div>
                            <div class="col-4 text-end">
                                <a href="@Url.Action("AddRouteToCart", "ShoppingCart", new { id = route.RouteId })"
                                   class="btn btn-success">
                                    <i class="bi bi-cart-plus"></i> Add to Cart
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-warning">
            No routes found matching your criteria. You may find separate flights <a asp-area="" asp-controller="Flights" asp-action="Index">here</a>.
        </div>
    }

    @if (Model.hotels.Any())
    {
        <div class="mt-4">
            <h4>Recommended Hotels</h4>
            @foreach (var hotel in Model.hotels)
            {
                <div class="hotel-tile">
                    @await Html.PartialAsync("DisplayTemplates/_HotelTile", hotel)
                </div>
            }
        </div>
    }
</div>