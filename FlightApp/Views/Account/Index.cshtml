@model FlightApp.ViewModels.BookingHistoryHotelListVM

@{
    ViewData["Title"] = "Booking History";
}

<div class="container mt-4">
    <div class="card shadow border-info">
        <div class="card-header bg-info text-white">
            <h2><i class="bi bi-clock-history me-2"></i>Your Booking History</h2>
        </div>
        <div class="card-body">
            @if (Model.BookingHistory.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead class="table-light">
                            <tr>
                                <th>Booking ID</th>
                                <th>Type</th>
                                <th>Booking Date</th>
                                <th>From</th>
                                <th>To</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.BookingHistory)
                            {
                                <tr>
                                    <td>
                                        <span class="badge bg-secondary">#@item.BookingId</span>
                                    </td>
                                    <td>
                                        @if (item.IsDirectFlight)
                                        {
                                            <span class="badge bg-primary">Direct Flight</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">Route</span>
                                        }
                                    </td>
                                    <td>@item.BookingTime.ToString("dd MMM yyyy")</td>
                                    <td>
                                        <strong>@item.DepartureCity</strong>
                                    </td>
                                    <td>
                                        <strong>@item.ArrivalCity</strong>
                                    </td>
                                    <td>
                                        @if (item.PaymentStatus)
                                        {
                                            <span class="badge bg-success">Paid</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">Pending</span>
                                        }
                                    </td>
                                    <td>
                                        @Html.ActionLink("Delete", "Delete", new { id = item.BookingId})
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-airplane fs-1 text-muted"></i>
                    <h4 class="mt-3">No Booking History Found</h4>
                    <p class="text-muted">You haven't made any bookings yet.</p>
                    <div class="mt-4">
                        <a asp-controller="Flights" asp-action="GetRoutes" class="btn btn-success me-2">
                            <i class="bi bi-map me-2"></i>Browse Routes
                        </a>
                        <a asp-controller="Flights" asp-action="Index" class="btn btn-primary">
                            <i class="bi bi-airplane me-2"></i>Find Direct Flights
                        </a>
                    </div>
                </div>
            }
        </div>
    </div>

    @if (Model.Hotels.Any())
    {
        <div class="card shadow border-info mt-4">
            <div class="card-header bg-info text-white">
                <h3><i class="bi bi-building me-2"></i>Recommended Hotels</h3>
            </div>
            <div class="card-body">
                <div class="row">
                    @foreach (var hotel in Model.Hotels)
                    {
                        <div class="col-md-4 mb-4">
                            <div class="card h-100 shadow-sm">
                                @await Html.PartialAsync("DisplayTemplates/_HotelTile", hotel)
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>
