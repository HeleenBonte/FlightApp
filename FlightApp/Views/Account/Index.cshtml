@model FlightApp.ViewModels.BookingHistoryHotelListVM

@{
    ViewData["Title"] = "Index";
}

<h1>Booking History</h1>

@if(Model.BookingHistory.Count() != 0){
<table class="table">
    <thead>
        <tr>
            <th>
               Booking ID
            </th>
            <th>
                Payment Status
            </th>
            <th>
                Departure City
            </th>
            <th>
                Arrival City
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.BookingHistory) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.BookingId)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.PaymentStatus)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.DepartureCity)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ArrivalCity)
            </td>
            <td>
                @Html.ActionLink("Edit", "Edit", new { /* id=item.PrimaryKey */ }) |
                @Html.ActionLink("Details", "Details", new { /* id=item.PrimaryKey */ }) |
                @Html.ActionLink("Delete", "Delete", new { /* id=item.PrimaryKey */ })
            </td>
        </tr>
}
    </tbody>
</table>
}
else{
    <p>You have not yet booked any flights. Click <a  asp-area="" asp-controller="Flights" asp-action="GetRoutes">HERE</a> to find a route.</p>
}

@if (Model.Hotels.Count() != 0)
{
    <div>
        @foreach (var item in Model.Hotels)
        {
            <div class="hotel-tile">
                @await Html.PartialAsync("DisplayTemplates/_HotelTile", item)
            </div>
        }
    </div>
}


