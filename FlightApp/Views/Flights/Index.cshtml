@model FlightApp.ViewModels.FlightsCityVM

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Find Flights</title>
    <link href="~/lib/jqueryui/themes/base/jquery-ui.min.css" rel="stylesheet" />
</head>
<body>

<h1>FLights</h1>
<div class="row">
    <div class="col-md-4">
        <form asp-action="Index"
              data-ajax="true"
              data-ajax-method="POST"
              data-ajax-mode="replace"
              data-ajax-update="#content"
              data-ajax-loading="#divloading"
              data-ajax-success="Success"
              data-ajax-failure="Failure">

            <div class="form-group">
                <label for="DepartureCityID" class="control-label">Departure City</label>
                <select asp-for="DepartureCityID" asp-items="@Model.Cities">
                    <option>Please select</option>
                </select>
            </div>

            <div class="form-group">
                <label for="ArrivalCityID" class="control-label">Arrival City</label>
                <select asp-for="ArrivalCityID" asp-items="@Model.Cities">
                    <option>Please select</option>
                </select>
            </div>

            <div class="form-group">
                <label for="DepartureDate" class="control-label">Departure Date</label>
                <input type="text" asp-for="DepartureDate" id="DepartureDate" />
                <span asp-validation-for="DepartureDate " class="text-danger"></span>
            </div>

            <button id="submit" type="submit" class="btn btn-primary">Search</button>
        </form>
    </div>
</div>
<hr />
<div id="content">
    <p>No Cities have been selected yet</p>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

<script src="~/lib/jquery-ajax-unobtrusive/jquery.unobtrusive-ajax.min.js"></script>
<script src="https://code.jquery.com/jquery-3.7.1.js"></script>
<script src="https://code.jquery.com/ui/1.14.1/jquery-ui.js"></script>
<script>
    $("#submit").on("click", () => {

        $("form").trigger("submit");
    });
    $( function () {
        $("#DepartureDate").datepicker({
            showOtherMonths: true,
            selectOtherMonths: true,
            minDate: '+3D',
            maxDate: '+6M',
            dateFormat: 'dd/mm/yy',
        });
    });
</script>
}
</body>

</html>
