@model FlightApp.ViewModels.RouteCityVM

<div class="container mt-4">
    <div class="card shadow border-success">
        <div class="card-header bg-success text-white">
            <h2><i class="bi bi-map me-2"></i>Find Routes with Connections</h2>
        </div>
        <div class="card-body">
            <form asp-action="GetRoutes"
                  data-ajax="true"
                  data-ajax-method="POST"
                  data-ajax-mode="replace"
                  data-ajax-update="#content"
                  data-ajax-loading="#divloading"
                  data-ajax-success="Success"
                  data-ajax-failure="Failure">

                @Html.AntiForgeryToken()

                <div class="row">
                    <div class="col-md-5 mb-3">
                        <div class="form-group">
                            <label for="DepartureCityID" class="form-label fw-bold">
                                <i class="bi bi-airplane-engines me-1"></i> Departure City
                            </label>
                            <select asp-for="DepartureCityID" asp-items="@Model.Cities" class="form-select form-select-lg">
                                <option>Please select</option>
                            </select>
                            <span asp-validation-for="DepartureCityID" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="col-md-5 mb-3">
                        <div class="form-group">
                            <label for="ArrivalCityID" class="form-label fw-bold">
                                <i class="bi bi-geo-alt-fill me-1"></i> Arrival City
                            </label>
                            <select asp-for="ArrivalCityID" asp-items="@Model.Cities" class="form-select form-select-lg">
                                <option>Please select</option>
                            </select>
                            <span asp-validation-for="ArrivalCityID" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="col-md-2 mb-3">
                        <div class="form-group">
                            <label for="DepartureDate" class="form-label fw-bold">
                                <i class="bi bi-calendar-event me-1"></i> Date
                            </label>
                            <input type="text" asp-for="DepartureDate" id="DepartureDate" class="form-control form-control-lg" placeholder="DD/MM/YYYY" />
                            <span asp-validation-for="DepartureDate" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <div class="d-grid gap-2 d-md-flex justify-content-md-end mt-3">
                    <button type="submit" class="btn btn-success btn-lg">
                        <i class="bi bi-search me-2"></i>Search Routes
                    </button>
                </div>
            </form>

            <div id="divloading" class="text-center my-3" style="display:none;">
                <div class="spinner-border text-success" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <p class="mt-2">Searching for routes...</p>
            </div>
        </div>
    </div>

    <div class="mt-4" id="content">
        <div class="text-center text-muted py-5">
            <i class="bi bi-arrow-up-circle fs-1"></i>
            <p class="mt-3">Select departure and arrival cities to search for available routes</p>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="~/lib/jquery-ajax-unobtrusive/jquery.unobtrusive-ajax.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.7.1.js"></script>
    <script src="https://code.jquery.com/ui/1.14.1/jquery-ui.js"></script>
    <script>
        $(function () {
            // Add authentication headers to all AJAX requests
            $.ajaxSetup({
                headers: {
                    'X-CSRF-TOKEN': $('input[name="__RequestVerificationToken"]').val()
                },
                xhrFields: {
                    withCredentials: true
                }
            });

            $("#DepartureDate").datepicker({
                showOtherMonths: true,
                selectOtherMonths: true,
                minDate: '+3D',
                maxDate: '+6M',
                dateFormat: 'dd/mm/yy',
                changeMonth: true,
                changeYear: true
            });
        });

        // Custom success handler for AJAX
        function Success(data) {
            console.log("AJAX request completed successfully");
        }

        // Custom failure handler for AJAX
        function Failure(xhr, status, error) {
            console.error("AJAX request failed:", status, error);
        }
    </script>
}
